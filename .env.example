# Django секретный ключ (сгенерируйте свой: https://djecrety.ir/)
SECRET_KEY=your-secret-key-here-replace-with-real-one-in-.env

# Режим отладки (True - разработка, False - продакшен)
DEBUG=True

# Разрешенные хосты (для продакшена укажите домен)
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Настройки почты (Yandex/Gmail/другой SMTP)
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password

# База данных (SQLite по умолчанию)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Если перейдете на PostgreSQL, раскомментируйте и заполните:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=hotel_db
# DB_USER=postgres
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432